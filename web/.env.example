# Base map style for the dashboard.
#
# Default is OpenFreeMap: no API key, no rate limit, single origin.
# Copy to .env.local to override.

# OpenFreeMap (default)
# VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
# VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/bright

# Carto Positron — note that cartocdn.com is on some ad-blocking filter lists
# VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# MapLibre demo tiles — coarse, but useful to prove the pipeline works
# VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json
